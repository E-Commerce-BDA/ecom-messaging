{
  "name": "@ecom/messaging",
  "version": "0.6.0",
  "private": true,
  "description": "Transactional outbox relay, event publishers and Kafka consumers shared by every E-Commerce service",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "import": "./dist/nest/index.js"
    },
    "./nest/consumer": {
      "types": "./dist/nest/consumer.d.ts",
      "import": "./dist/nest/consumer.js"
    },
    "./nest/outbox": {
      "types": "./dist/nest/outbox.module.d.ts",
      "import": "./dist/nest/outbox.module.js"
    },
    "./nest/tasks": {
      "types": "./dist/nest/tasks.module.d.ts",
      "import": "./dist/nest/tasks.module.js"
    },
    "./tasks": {
      "types": "./dist/tasks/index.d.ts",
      "import": "./dist/tasks/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@aws-sdk/client-sqs": "^3.1100.0",
    "@ecom/contracts": ">=2.0.0 <3",
    "@nestjs/common": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "kafkajs": "^2.2.4"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-sqs": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/microservices": {
      "optional": true
    },
    "kafkajs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "^3.1161.0",
    "@ecom/contracts": "file:../ecom-contracts/ecom-contracts-2.0.0.tgz",
    "@nestjs/common": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@types/node": "^24.0.0",
    "kafkajs": "^2.2.4",
    "reflect-metadata": "^0.2.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
